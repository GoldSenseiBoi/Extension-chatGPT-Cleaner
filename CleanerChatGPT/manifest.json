{
  "manifest_version": 3,
  "name": "CleanerChatGPT",
  "version": "1.0.0",
  "description": "CleanerChatGPT lets you select and delete ChatGPT conversations in bulk.",
  "icons": {
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
