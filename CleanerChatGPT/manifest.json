{
  "manifest_version": 3,
  "name": "CleanerChatGPT",
  "version": "1.0.0",
  "description": "CleanerChatGPT lets you select and delete ChatGPT conversations in bulk.",
  "icons": {
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "tabs",
    "activeTab",
    "storage",
    "cookies",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  }
}
