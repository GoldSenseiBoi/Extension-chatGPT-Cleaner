{
  "manifest_version": 3,
  "name": "CleanerChatGPT",
  "version": "1.0.0",
  "description": "CleanerChatGPT lets you view, select and delete multiple ChatGPT conversations with ease using OpenAI's API."


,
  "icons": {
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "cookies",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },"content_scripts": [
  {
    "matches": ["https://chatgpt.com/*"],
    "js": ["scripts/content.js"],
    "run_at": "document_idle"
  }
]
  
}
